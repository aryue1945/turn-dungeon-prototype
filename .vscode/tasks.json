{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\New Game Project.csproj",
                "--configuration",
                "Debug",
                "--nologo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "test",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}\\New Game Project.sln",
                "--configuration",
                "Debug",
                "--nologo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "import-assets",
            "type": "process",
            "command": "C:\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
            "args": [
                "--headless",
                "--path",
                "${workspaceFolder}",
                "--import"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "prepare",
            "dependsOrder": "sequence",
            "dependsOn": [
                "import-assets",
                "test"
            ],
            "problemMatcher": []
        }
    ]
}
